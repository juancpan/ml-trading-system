# Git ignore rules — ml-trading-system

# Environment & secrets (never commit)
.env
.env.*

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Data files (users source their own market data)
data/
*.csv
*.parquet

# Trained model artifacts (regenerated by training; never commit weights)
*.pkl
*.joblib
*.h5
*.keras
*.onnx

# Runtime state / caches produced by the execution layer
execution/strategy_models/
execution/execution_journals/
execution/logs/
execution/*state*.json
execution/*_cache.json
execution/pending_limit_orders.json
execution/KILL_SWITCH_ACTIVE
execution/SOFT_HALT_ACTIVE
execution/DAILY_MOVE_ACTIVE
execution/signal_history.parquet
execution/equity_history.parquet
execution/shadow_history.parquet
.ibkr_client_ids/

# WFOV runtime outputs
algos/wfov/results/
algos/wfov/baselines/
algos/wfov/deployment_recommendations/
algos/wfov/trials_ledger.db

# Logs & images
logs/
*.log
*.log.*
*.png
*.jpg

# OS
.DS_Store
Thumbs.db
._*
